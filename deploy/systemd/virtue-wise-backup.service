[Unit]
Description=VIRTUE WISE verified local database backup
After=local-fs.target

[Service]
Type=oneshot
User=virtuewise
Group=virtuewise
WorkingDirectory=/opt/virtue-wise
EnvironmentFile=-/etc/virtue-wise/backup.env
ExecStart=/opt/virtue-wise/.venv/bin/python -m app.backup create
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/virtue-wise /var/backups/virtue-wise
